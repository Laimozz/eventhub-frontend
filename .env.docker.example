# Copy to .env.docker; run Compose from eventhub-frontend.
BACKEND_CONTEXT=../eventhub-backend
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Required. For the bundled DB these create a NEW database/user on first start.
DB_NAME=eventhub_db
DB_USERNAME=eventhub
DB_PASSWORD=

# Required: Base64 of at least 32 cryptographically random bytes. See DOCKER.md.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Use the exact origin opened in the browser (no trailing slash).
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Optional: all three are needed to upload images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: VNPay merchant credentials; leave empty to disable paid checkout.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/customer/payment-result

# Optional: enable only after filling in the SMTP settings and sender.
PAYMENT_EMAIL_ENABLED=false
PAYMENT_EMAIL_FROM=
PAYMENT_EMAIL_FRONTEND_URL=http://localhost:5173
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional: both key and model are needed for the backend chatbot.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=1800
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_REASONING_ENABLED=
OPENROUTER_TIMEOUT=45s

# Only used with compose.external-db.yml. "localhost" would mean the BE container.
# DB_URL=jdbc:postgresql://host.docker.internal:5432/eventhub_db
